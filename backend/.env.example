# Server Configuration
PORT=5000
NODE_ENV=development

# MariaDB Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=textile_erp_db
DB_USER=textile_admin
DB_PASSWORD=textile_password
DB_DIALECT=mariadb
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# ERPNext Frappe REST API Configuration
ERPNEXT_BASE_URL=http://127.0.0.1:8000
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret
ERPNEXT_COMPANY=cubet

